rules_version = '2';

// Lenape Bronx Map
// Architecture: static site with Firebase Auth for admin access.
// Student submissions keep the no-password email-entry workflow. Because
// that email is self-reported, Firestore cannot prove ownership: student
// records are readable and an email match is only a client-side convenience.
// Verified Google roles protect the admin dashboard. Tech support manages
// access, exports, recovery, and deletion.

service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────────────────────────
    // Helpers
    // ──────────────────────────────────────────────────────────────────
    function isTechSupport() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'emile.giovannie@gmail.com';
    }

    function isStudentAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admin_roles/$(request.auth.token.email))
        && get(/databases/$(database)/documents/admin_roles/$(request.auth.token.email)).data.role == 'content_admin';
    }

    function isContentAdmin() {
      return isTechSupport() || isStudentAdmin();
    }

    function isReviewUpdate() {
      return isStudentAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['email', 'status', 'approvedAt', 'updatedAt'])
        && request.resource.data.get('email', '') is string
        && (request.resource.data.get('email', '') == ''
          || isClassEmail(request.resource.data.get('email', '')))
        && request.resource.data.get('status', resource.data.get('status', 'pending'))
          in ['pending', 'approved', 'rejected'];
    }

    // Owner email must be a CUNY address. Roster check goes here later.
    function isClassEmail(email) {
      return email is string
        && email.matches('^[^@A-Z]+@(lc|lehman)[.]cuny[.]edu$');
    }

    function isValidAdminEmail(email) {
      return email is string
        && email.matches('^[^@]+@[^@]+[.][^@]+$');
    }

    // Email-only student edit: the self-reported owner email stays fixed;
    // edits return the item to the review queue. This is not identity proof.
    function isStudentEdit(editable, maxSize) {
      return resource.data.get('email', '') != ''
        && request.resource.data.get('email', '') == resource.data.email
        && request.resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(editable)
        && request.resource.size() < maxSize;
    }

    function isStudentEditOfAnnotation() {
      return isStudentEdit(['note', 'sources', 'videoUrl', 'photos', 'status', 'updatedAt'], 50000);
    }

    function isStudentEditOfSubmission() {
      return isStudentEdit(['name', 'description', 'sources', 'videoUrl', 'photos', 'status', 'updatedAt'], 100000);
    }

    // ──────────────────────────────────────────────────────────────────
    // Public submissions (student-proposed new sites). Visitors can read
    // approved records; verified owners can create and edit their own.
    // Tech support can restore missing records from an export.
    // ──────────────────────────────────────────────────────────────────
    match /submissions/{id} {
      allow read: if true;
      allow create: if isTechSupport() || (
          request.resource.data.keys().hasAny(['student_name','studentName','name'])
          && isClassEmail(request.resource.data.get('email', null))
          && request.resource.data.status == 'pending'
          && request.resource.size() < 100000
        );
      allow update: if isReviewUpdate() || isStudentEditOfSubmission() || isTechSupport();
      allow delete: if isTechSupport();
    }

    // Public annotations (notes attached to existing settlements).
    match /annotations/{id} {
      allow read: if true;
      allow create: if isTechSupport() || (
          isClassEmail(request.resource.data.get('email', null))
          && request.resource.data.status == 'pending'
          && request.resource.size() < 50000
        );
      allow update: if isReviewUpdate() || isStudentEditOfAnnotation() || isTechSupport();
      allow delete: if isTechSupport();
    }

    // Backups are support-only. Public clients must not be able to fill
    // these collections with arbitrary copies.
    match /backups_submissions/{id} {
      allow read, create, delete: if isTechSupport();
      allow update: if false;
    }

    match /backups_annotations/{id} {
      allow read, create, delete: if isTechSupport();
      allow update: if false;
    }

    // Tech support is the only account that can grant or remove admin access.
    match /admin_roles/{email} {
      allow get: if isTechSupport()
        || (request.auth != null && request.auth.token.email_verified == true
          && request.auth.token.email == email);
      allow list: if isTechSupport();
      allow create, update: if isTechSupport()
        && request.resource.data.get('email', '') == email
        && isValidAdminEmail(email)
        && request.resource.data.get('role', '') == 'content_admin'
        && request.resource.data.keys().hasOnly(['email', 'role', 'grantedBy', 'grantedAt']);
      allow delete: if isTechSupport();
    }

    // Everything else locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
