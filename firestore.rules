rules_version = '2';

// Lenape Bronx Map
// Architecture: static site with Firebase Auth for admin access.
// Public visitors can read (so the map can display approved content)
// and create (student submissions). Students can also edit their own
// pending work (typo fixes, etc.) — but once a submission is approved,
// it locks. Only admins can approve, reject, or delete.
//
// Why public read: the map page is unauthenticated; without it, students
// and visitors see an empty map. Submissions are only displayed if their
// status is 'approved' (filtered client-side in submit.js), and student
// names/emails are content the students themselves chose to publish.
//
// Student sign-in (2026-10-12): students type a CUNY email before they
// submit or edit (honor system, no password). Rules enforce:
//   - new entries must carry an @lc.cuny.edu or @lehman.cuny.edu email
//   - students can edit any entry that has an owner email (approved ones
//     too), but every student edit goes back to 'pending' for review
//   - students can't change the owner email or who/where an entry is
//   - entries with no owner email (pre-sign-in) are admin-only until an
//     admin sets an owner email in admin.html
// Ownership is checked in the browser (isMine in submit.js); rules can't
// see who typed the email. A class roster can tighten isClassEmail later.
//
// Keep the admin list in sync with ADMIN_EMAILS in admin.html, and the
// domains in sync with CUNY_DOMAINS in submit.js.

service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────────────────────────
    // Helpers
    // ──────────────────────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'emile.giovannie@gmail.com',
          'agescamilla2006@gmail.com'
        ];
    }

    // Owner email must be a CUNY address. Roster check goes here later.
    function isClassEmail(email) {
      return email is string
        && email.matches('^[^@A-Z]+@(lc|lehman)[.]cuny[.]edu$');
    }

    // Student edit: entry has an owner, owner unchanged, goes back to
    // pending (students can't self-approve), only content fields change.
    function isStudentEdit(editable, maxSize) {
      return resource.data.get('email', '') != ''
        && request.resource.data.get('email', '') == resource.data.email
        && request.resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(editable)
        && request.resource.size() < maxSize;
    }

    function isStudentEditOfAnnotation() {
      return isStudentEdit(['note', 'sources', 'videoUrl', 'photos', 'status', 'updatedAt'], 50000);
    }

    function isStudentEditOfSubmission() {
      return isStudentEdit(['name', 'description', 'sources', 'videoUrl', 'photos', 'status', 'updatedAt'], 100000);
    }

    // ──────────────────────────────────────────────────────────────────
    // Public submissions (student-proposed new sites). Anyone can read
    // (map display); CUNY-email students can create and edit their own.
    // Only admins can approve, reject, or delete.
    // ──────────────────────────────────────────────────────────────────
    match /submissions/{id} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasAny(['student_name','studentName','name'])
        && isClassEmail(request.resource.data.get('email', null))
        && request.resource.data.status == 'pending'
        && request.resource.size() < 100000;
      allow update: if isAdmin() || isStudentEditOfSubmission();
      allow delete: if isAdmin();
    }

    // Public annotations (notes attached to existing settlements).
    match /annotations/{id} {
      allow read: if true;
      allow create: if isClassEmail(request.resource.data.get('email', null))
        && request.resource.data.status == 'pending'
        && request.resource.size() < 50000;
      allow update: if isAdmin() || isStudentEditOfAnnotation();
      allow delete: if isAdmin();
    }

    // Write-once backup archives. Admin-only read; nobody can update.
    match /backups_submissions/{id} {
      allow read: if isAdmin();
      allow create: if request.resource.size() < 1000000;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /backups_annotations/{id} {
      allow read: if isAdmin();
      allow create: if request.resource.size() < 1000000;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Everything else locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
